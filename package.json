{
  "name": "nythera",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:backend": "pnpm --filter @nythera/backend dev",
    "dev:frontend": "pnpm --filter @nythera/frontend dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @nythera/backend db:generate",
    "db:migrate": "pnpm --filter @nythera/backend db:migrate",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  }
}
