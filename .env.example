# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=nythera
DB_PASSWORD=change-me
DB_NAME=nythera

# Backend
PORT=4000
CORS_ORIGIN=https://your-domain.example
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Frontend (Vite, must be prefixed VITE_)
# Leave empty for same-origin deployment (backend serves the built frontend itself, e.g.
# behind a single CloudPanel/nginx reverse-proxy host). Only set these if the frontend is
# hosted on a different origin than the backend (e.g. separate local dev servers).
VITE_API_URL=
VITE_GATEWAY_URL=

# Same-origin deployment: backend serves the built frontend directly
SERVE_FRONTEND=true
APP_PUBLIC_URL=https://your-domain.example

# Billing (Stripe + PayPal, sandbox/test mode) - optional, app boots without these
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_PLAN_ID=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
